1 CLS:PRINT"W64TEST V5":T=PEEK(&H27)*256+PEEK(&H28)
2 PRINT"TOP OF BASIC RAM &H";HEX$(T):PRINT"ROM";PEEK(&H8B2D);PEEK(&H8B2E);PEEK(&H8B2F)
3 IF T>=&H7BFE OR (T>=&H77FE AND PEEK(&H781F)=87) THEN 10
4 PRINT"$";HEX$(T+1);"-$7FFF IS IN USE (DOS":PRINT"OR EXTENSION?). W64LIB NEEDS":PRINT"$7800-$7BFF. PLEASE REPORT.":END
10 CLEAR 500,&H77FF:M=0
15 PRINT"LOADING W64LIB.BIN"
20 LOAD"W64LIB.BIN"
25 IF PEEK(&H781F)<>87 OR PEEK(&H7823)<>4 THEN PRINT"W64LIB.BIN DID NOT LOAD AT $7800":END
26 PRINT"OK. FIRST REGISTER PAGE":PRINT"(IF IT STOPS: DIGIT BOTTOM RIGHT?)"
30 L=&H7800:P=&H7BF0:W=6:R=10:B=&HC00
60 F=0:X=&H40:E=0:POKE &H7BEC,0:GOSUB 9000:IF PEEK(&H7BEC)=0 THEN 100
70 PRINT"NO FIELD SYNC FLAG ($FF03 BIT 7)":PRINT"PLEASE REPORT. ANY KEY GOES ON"
80 IF INKEY$="" THEN 80
100 F=0:X=&H40:E=0:GOSUB 9000:POKE P+14,0:EXEC L+6:CLS
110 PRINT"COCOVGA W64 TEST  DRAGON BASIC"
115 PRINT"(RGBTOHDMI MC6847 LUMACODE)  V4":PRINT
120 PRINT"1 64 COLUMN TEXT, T1 + 6847 FONT"
130 PRINT"2 64 COLUMN CHARACTER SET"
140 PRINT"3 64 COLUMN TYPING + SCROLL"
150 PRINT"4 SCROLL STRESS     (30 S)"
160 PRINT"5 FULL SCREEN STRESS (30 S)"
170 PRINT"6 64 COLUMN ORANGE SET"
180 PRINT"7 64 COLUMN INVERSE VIDEO"
190 PRINT"8 32 COL LOWER CASE   (STAGE 2)"
195 PRINT"9 PMODE 4 ARTIFACTS   (STAGE 2)"
196 PRINT"A RUN ALL (AUTO, 5 S PER SCREEN)"
197 PRINT"0 EXIT TO BASIC":PRINT
198 PRINT"ANY KEY ENDS A SCREEN, A KEY"
199 PRINT"STOPS A STRESS TEST EARLY."
200 K$=INKEY$:IF K$="A" THEN 300
205 IF K$<"0" OR K$>"9" THEN 200
210 K=VAL(K$):IF K=0 THEN 8000
220 ON K GOSUB 1000,2000,3000,4000,5000,6000,7000,7500,7800
230 GOTO 100
300 M=1
310 FOR J=1 TO 9:GOSUB 9300:ON J GOSUB 1000,2000,3000,4000,5000,6000,7000,7500,7800:NEXT J
320 M=0:GOTO 100
1000 F=3:GOSUB 1100:GOSUB 1200:GOSUB 9200
1010 F=0:GOSUB 9000:GOSUB 1210:GOSUB 9200:RETURN
1100 E=2:GOSUB 9000:POKE P+9,&H60:POKE P+14,W:EXEC L+21:POKE P+14,W:EXEC L+3:RETURN
1200 V=B:Z=64
1210 Y=0:H=0:S$="COCOVGA 64 COLUMN TEXT   FONT"+STR$(F)+"  EXTRAS"+STR$(X)+"      ":GOSUB 9100
1220 Y=1:S$="0123456789012345678901234567890123456789012345678901234567890123":GOSUB 9100
1230 Y=2:S$="ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^_ !#$%&'()*+,-./0123456789:;<=>?@":GOSUB 9100
1240 Y=3:S$="abcdefghijklmnopqrstuvwxyz{|}~` lower case, inverse in 6847 font":GOSUB 9100
1250 Y=4:S$="The quick brown fox jumps over the lazy dog. THE QUICK BROWN FOX":GOSUB 9100
1260 FOR Y=6 TO 30:S$=RIGHT$(STR$(Y),2):H=0:GOSUB 9100:H=62:GOSUB 9100:NEXT Y
1270 Y=31:H=0:S$="LAST LINE 31 - PRESS A KEY":GOSUB 9100:POKE B+2047,&H6A:RETURN
2000 F=3:GOSUB 1100:POKE P+14,W:EXEC L+24:GOSUB 9200
2010 F=0:GOSUB 9000:GOSUB 9200:RETURN
3000 F=3:GOSUB 1100:V=B:Z=64:H=0:U=0:N=0
3005 G$="Hello from Dragon BASIC in 64 columns."+CHR$(13)+"lower case: abcdefghijklmnopqrstuvwxyz"+CHR$(13)
3006 G$=G$+"UPPER CASE: ABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789"+CHR$(13)+"A long line wraps at column 64 and scrolls the screen up by one line."+CHR$(13)
3010 Y=0:S$="TYPING TEST - ENTER NEW LINE, UP ARROW CASE, CLEAR EXIT":GOSUB 9100
3020 Q=B+1984
3030 POKE Q+H,&H20
3040 IF M=1 THEN 3200
3045 K$=INKEY$:IF K$="" THEN 3040
3050 C=ASC(K$):IF C=12 THEN RETURN
3060 IF C=94 THEN U=32-U:GOTO 3040
3070 IF C=13 THEN POKE Q+H,&H60:POKE P+14,W:EXEC L+12:H=0:GOTO 3030
3080 IF C=8 THEN IF H>0 THEN POKE Q+H,&H60:H=H-1:GOTO 3030
3090 IF C<32 OR C>95 THEN 3040
3100 IF C>=65 AND C<=90 THEN C=C+U
3110 D=C+64:IF C>=64 THEN D=C:IF C>=96 THEN D=C-96
3120 POKE Q+H,D:H=H+1:IF H>63 THEN POKE P+14,W:EXEC L+12:H=0
3130 GOTO 3030
3200 N=N+1:IF N>LEN(G$) THEN GOSUB 9200:RETURN
3230 C=ASC(MID$(G$,N,1)):IF C=13 THEN 3070
3240 GOTO 3110
4000 F=3:GOSUB 1100:GOSUB 1200:N=750:GOSUB 9400:POKE P+14,W:EXEC L+15:RETURN
5000 F=3:GOSUB 1100:N=375:GOSUB 9400:POKE P+14,W:EXEC L+18:RETURN
6000 F=3:GOSUB 1100:GOSUB 1200:POKE P+14,W+128:EXEC L+3:GOSUB 9200:RETURN
7000 F=3:X=&H60:GOSUB 1100:GOSUB 1200:GOSUB 9200:RETURN
7500 F=3:E=0:GOSUB 9000:POKE P+14,0:EXEC L+6:CLS:V=&H400:Z=32
7510 Y=0:H=0:S$="32 COLUMN LOWER CASE  (STAGE 2)":GOSUB 9100
7520 FOR I=0 TO 63:POKE &H440+I,I:NEXT I
7530 Y=5:S$="The quick brown fox jumps over":GOSUB 9100
7540 Y=6:S$="the lazy dog. 0123456789 ABCDEF":GOSUB 9100
7550 Y=8:S$="Mixed Case Text On A 32 Column":GOSUB 9100
7560 Y=9:S$="Screen: abc ABC xyz XYZ {|}~":GOSUB 9100
7570 Y=15:S$="KEY: ORANGE SET":GOSUB 9100:GOSUB 9200
7580 POKE P+14,128:EXEC L+6:Y=15:S$="KEY: 6847 FONT ":GOSUB 9100:GOSUB 9200
7590 F=0:GOSUB 9000:POKE P+14,0:EXEC L+6:Y=15:S$="KEY: MENU      ":GOSUB 9100:GOSUB 9200:RETURN
7800 PMODE4,1:PCLS:SCREEN1,1
7810 FOR I=0 TO 62 STEP 2:LINE(I,0)-(I,95),PSET:NEXT I
7820 FOR I=65 TO 127 STEP 2:LINE(I,0)-(I,95),PSET:NEXT I
7830 LINE(128,0)-(191,95),PSET,BF
7840 FOR I=192 TO 252 STEP 4:LINE(I,0)-(I+1,95),PSET,BF:NEXT I
7850 FOR I=96 TO 190 STEP 2:LINE(0,I)-(255,I),PSET:NEXT I
7860 CIRCLE(128,144),40:GOSUB 9200
7870 SCREEN1,0:GOSUB 9200:SCREEN0,0:RETURN
8000 CLS:PRINT"W64TEST ENDED":END
9000 POKE P,0:POKE P+1,&H85:POKE P+2,0:POKE P+3,F:POKE P+4,0:POKE P+5,X:POKE P+6,0:POKE P+7,0:POKE P+8,E:POKE P+14,R:EXEC L+0:RETURN
9100 Q=V+Y*Z+H:POKE P+12,INT(Q/256):POKE P+13,Q-INT(Q/256)*256:D=VARPTR(S$):POKE P+14,INT(D/256):POKE P+15,D-INT(D/256)*256:EXEC L+27:RETURN
9200 T=TIMER:O=0
9210 O=O+1:IF TIMER-T<25 AND O<300 THEN 9210
9220 IF INKEY$<>"" THEN 9220
9230 IF M=1 THEN IF TIMER-T>250 THEN RETURN
9235 IF INKEY$="" THEN 9230
9240 RETURN
9300 F=0:X=&H40:E=0:GOSUB 9000:POKE P+14,0:EXEC L+6:RETURN
9400 IF M=1 THEN N=INT(N/3)
9410 POKE P+10,INT(N/256):POKE P+11,N-INT(N/256)*256:RETURN
